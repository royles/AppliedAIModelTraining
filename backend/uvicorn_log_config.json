{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "once_per_route": {
      "()": "app.logging_access.LogEachRouteOnceFilter"
    }
  },
  "formatters": {
    "default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(levelprefix)s %(message)s",
      "use_colors": null
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s"
    }
  },
  "handlers": {
    "default": {
      "formatter": "default",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stderr"
    },
    "access": {
      "formatter": "access",
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "filters": ["once_per_route"]
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["default"],
      "level": "ERROR",
      "propagate": false
    },
    "uvicorn.error": {
      "level": "ERROR"
    },
    "uvicorn.access": {
      "handlers": [],
      "level": "ERROR",
      "propagate": false
    },
    "root": {
      "handlers": ["default"],
      "level": "ERROR"
    },
    "app": {
      "handlers": ["default"],
      "level": "ERROR",
      "propagate": false
    }
  }
}
